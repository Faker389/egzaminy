<Window x:Class="hasla.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:hasla"
        mc:Ignorable="d"
        Background="#B0C4DE"
        Title="Dodaj pracownika" Height="450" Width="800">
    <Grid>
        <GroupBox Header="Dane Pracownika" Margin="25,21,445,108">
            <Grid  >
                <Label Content="Imię" FontSize="17px" HorizontalAlignment="Left" Margin="8,17,0,0" VerticalAlignment="Top"/>
                <TextBox HorizontalAlignment="Left" Name="NameTextBox" FontSize="17px" Margin="106,24,0,0" TextWrapping="Wrap"   VerticalAlignment="Top" Width="199" Height="26"/>
                <Label Content="Nazwisko" FontSize="17px"  HorizontalAlignment="Left" Margin="10,73,0,0" VerticalAlignment="Top"/>
                <TextBox HorizontalAlignment="Left" Name="LastNameTextBox" FontSize="17px" Margin="106,80,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="199" Height="26"/>
                <Grid Margin="10,111,10,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Stanowisko" FontSize="17px" HorizontalAlignment="Left" Margin="0,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.137,0.481"/>
                    <ComboBox Grid.Column="1"   
              Name="Position"  
              Grid.ColumnSpan="2"
              VerticalAlignment="Top"
              Margin="0,10,0,0">
                        <ComboBoxItem>Kierownik</ComboBoxItem>
                        <ComboBoxItem>Starszy programista</ComboBoxItem>
                        <ComboBoxItem>Młodszy programista</ComboBoxItem>
                        <ComboBoxItem>Tester</ComboBoxItem>
                    </ComboBox>
                </Grid>

            </Grid>

        </GroupBox>
        <GroupBox Header="Generowanie hasła" Margin="414,21,56,108">
            <Grid>
                <Label Content="Ile znaków?" FontSize="17px" HorizontalAlignment="Left" Margin="20,17,0,0" VerticalAlignment="Top"/>
                <TextBox HorizontalAlignment="Left" Name="PasswordLength" FontSize="17px" Margin="143,24,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="165" Height="26"/>
                <CheckBox Content="Małe i wielkie litery" x:Name="LoweAndUpperCharacters" FontSize="16" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="20,70,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.337,-0.288"/>
                <CheckBox Content="Cyfry" x:Name="Digits" FontSize="16" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="20,111,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.337,-0.288"/>
                <CheckBox Content="Znaki specjalne" x:Name="SpecialCharacters" FontSize="16" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="20,150,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.337,-0.288"/>
                <Button Content="Generuj hasło" Background="#4682B4"   HorizontalAlignment="Center" Margin="0,227,0,0" Padding="2 5 2 5" VerticalAlignment="Top" Foreground="White" Click="Button_Click"/>

            </Grid>
        </GroupBox>
        <Button Content="Zatwierdź" Background="#4682B4"   HorizontalAlignment="Left" Margin="308,365,0,0" Padding="2 5 2 5" VerticalAlignment="Top" Foreground="White" Width="155" Click="Button_Click_1"/>

    </Grid>
</Window>
