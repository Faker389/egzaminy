<Window x:Class="paszporty.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:paszporty"
        Background="#5F9EA0"
        mc:Ignorable="d"
        Title="Wprowadzenie danych do paszportu. Wykonał:" Height="450" Width="800">
    <Grid>
        <Label Content="Numer" HorizontalAlignment="Left" Margin="20,31,0,0" VerticalAlignment="Top"/>
        <TextBox HorizontalAlignment="Left" FontSize="16"  LostFocus="NumberTextBox_LostFocus" Name="NumberTextBox" Background="#F0FFFF" Margin="93,31,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="274" Height="26"/>
        <Label Content="Imię" HorizontalAlignment="Left" Margin="20,76,0,0" VerticalAlignment="Top"/>
        <TextBox HorizontalAlignment="Left" FontSize="16" Name="NameTextBox" Background="#F0FFFF" Margin="93,76,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="274" Height="26"/>
        <Label Content="Nazwisko" HorizontalAlignment="Left"  Margin="20,123,0,0" VerticalAlignment="Top"/>
        <TextBox HorizontalAlignment="Left" FontSize="16" Name="LastNameTextBox" Background="#F0FFFF" Margin="93,123,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="274" Height="26"/>
        <GroupBox Header="Kolor oczu" Margin="21,200,432,83">
            <StackPanel >
                <RadioButton Content="Niebieskie" Name="RadioButton1" IsChecked="True" FontSize="14" Margin="5px 10px 0 10px"/>
                <RadioButton Content="Zielone" Name="RadioButton2" FontSize="14" Margin="5px 10px 0 10px"/>
                <RadioButton Content="Piwne" Name="RadioButton3" FontSize="14" Margin="5px 10px 0 10px"/>
            </StackPanel>
        </GroupBox>
        <Image HorizontalAlignment="Left" Name="Image1" Height="216" Margin="423,31,0,0" VerticalAlignment="Top" Width="179" Source="/000-zdjecie.jpg"/>
        <Image HorizontalAlignment="Left" Height="207" Name="Image2" Margin="633,31,0,0" VerticalAlignment="Top" Width="141" Source="/000-odcisk.jpg"/>
        <Button Content="OK" Padding="0 10px" Background="#F0FFFF" HorizontalAlignment="Left" Margin="423,287,0,0" VerticalAlignment="Top" Width="348" Click="Button_Click"/>

    </Grid>
</Window>
